{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://decap-cms.org https://*.decap-cms.org https://unpkg.com" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/index.html", "permanent": false },
    { "source": "/dashboard", "destination": "/_admin_korda_secret/index.html", "permanent": true }
  ]
}
